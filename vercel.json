{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/([a-zA-Z0-9_-]+)\\.html$", "dest": "/$1.html" },
    { "src": "^/api/(.*)$", "dest": "/api/$1" }
  ]
}
